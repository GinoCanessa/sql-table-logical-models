        "relatedArtifact": [
          {
            "type": "depends-on",
            "label": "patients",
            "resource": "https://example.org/sql/Library/active-patients"
          },
          {
            "type": "depends-on",
            "label": "visits",
            "resource": "https://example.org/sql/StructureDefinition/visit"
          }
        ],
        "parameter": [
          { "name": "minimum_cost", "use": "in", "min": 0, "max": "1", "type": "decimal" }
        ],
        "content": [
          {
            "contentType": "application/sql;dialect=sqlite",
            "extension": [
              {
                "url": "http://hl7.org/fhir/uv/sql-on-fhir/StructureDefinition/sql-text",
                "valueString": "SELECT p.patient_id, p.patient_name, v.id AS visit_id, v.occurred_on, v.cost FROM patients p JOIN visits v ON v.patient_id = p.patient_id WHERE (:minimum_cost IS NULL OR v.cost >= :minimum_cost) ORDER BY v.id"
              }
            ]
          }
        ]
      }
